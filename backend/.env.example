# Copy to ".env" (same folder) and fill in. ".env" is private and git-ignored.
# Order tried: 1) Ollama (local, no key)  2) Gemini  3) Groq  4) offline rules (always works).
# Everything works with NOTHING set; models only improve question understanding. Numbers never come from a model.
OLLAMA_MODEL=llama3.2
# quickest: rules first (about 0.03 ms), the LLM only when the rules cannot read the question
PARSER=fast
# OLLAMA_HOST=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# LLM_TIMEOUT=6
# ARGO_DATA=data/argo_subset.csv.gz
